<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>MPH_MultiGrave</defName>
        <label>MPH</label>
        <description>Description</description>
        
        <thingClass>MPH.Building_MPH</thingClass>
        <designationCategory>Misc</designationCategory>
        
        <!-- MPH 属性 -->
        <size>(3,2)</size>
        <costStuffCount>500</costStuffCount>

        <stuffCategories>
            <li>Stony</li>
        </stuffCategories>

        <passability>PassThroughOnly</passability>

        <useHitPoints>false</useHitPoints>

        <tickerType>Rare</tickerType>

        <!-- 注册自定义 Comp -->
        <comps>
            <li Class="MPH.CompProperties_MPHStorage" />
        </comps>
        
        <!-- 注册自定义 ITab 和原版储存方案 -->
        <inspectorTabs>
            <li>RimWorld.ITab_Storage</li>
            <li>MPH.ITab_MPH</li>
        </inspectorTabs>

        <graphicData>
            <texPath>Things/Building/MPH/MPH</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(3,3)</drawSize>
            <!-- 分别设置四个方向的偏移，按需微调数值 -->
            <drawOffsetNorth>(0, 0, 0.5)</drawOffsetNorth>
            <drawOffsetSouth>(0, 0, 0.5)</drawOffsetSouth>

        </graphicData>
        
        <building>
            <fixedStorageSettings>
                <filter>
                    <categories>
                        <li>Corpses</li> <!-- 允许所有尸体 -->
                    </categories>
                </filter>
            </fixedStorageSettings>  
        </building>
    </ThingDef>
</Defs>