    <Reference Include="UnityStubs">
      <HintPath>..\..\..\..\..\Steam\steamapps\common\RimWorld\UnityStubs.dll</HintPath>
	  <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>..\..\..\..\..\Steam\steamapps\common\RimWorld\Waylith.dll</HintPath>
	  <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
